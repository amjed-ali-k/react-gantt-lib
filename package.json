{
  "name": "react-gantt-lib",
  "version": "0.1.16",
  "description": "High-performance React Gantt chart with granular updates and customizable panels",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amjed-ali-k/react-gantt-lib.git"
  },
  "bugs": {
    "url": "https://github.com/amjed-ali-k/react-gantt-lib/issues"
  },
  "homepage": "https://amjed-ali-k.github.io/react-gantt-lib/",
  "keywords": [
    "react",
    "gantt",
    "chart",
    "timeline",
    "scheduler",
    "project-management"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./llm.txt": "./llm.txt"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "llm.txt"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "demo": "vite --config vite.demo.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "release:notes": "node scripts/release-notes.mjs",
    "release:notes:write": "node scripts/release-notes.mjs --version",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsdown": "^0.15.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
